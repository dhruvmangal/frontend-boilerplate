# Copy this file to .env to override project.config.json while developing.
# Only variables starting with EXPO_PUBLIC_ reach the app, and anyone with the
# app can read them, so never put passwords or secret keys here.

# Where your backend lives. "localhost" is swapped for your computer's address
# automatically, so the app on your phone can reach it (same Wi-Fi needed).
# EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# true = use the built-in fake data, false = call EXPO_PUBLIC_API_URL.
# EXPO_PUBLIC_USE_MOCKS=true
