{
  "name": "@app/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "The iPhone and Android apps: a Capacitor shell around the website in apps/web. Runs in the Android Emulator / iOS Simulator.",
  "scripts": {
    "android": "node scripts/native.mjs run android",
    "ios": "node scripts/native.mjs run ios",
    "open:android": "node scripts/native.mjs open android",
    "open:ios": "node scripts/native.mjs open ios",
    "sync": "node scripts/native.mjs sync",
    "build:android": "node scripts/native.mjs build android",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node -e \"\""
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "typescript": "5.9.3"
  }
}
