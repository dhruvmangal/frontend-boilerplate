# Copy this file to .env.local to override project.config.json while developing.
# Only variables starting with VITE_ reach the app, and they are visible to
# anyone who opens it, so never put passwords or secret keys here.

# Where your backend lives.
# VITE_API_URL=http://localhost:8080/api/v1

# true = use the built-in fake data, false = call VITE_API_URL.
# VITE_USE_MOCKS=true
