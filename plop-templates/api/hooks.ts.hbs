 *   const {{pluralCamel}} = use{{pluralPascal}}()   → {{pluralCamel}}.data, {{pluralCamel}}.isPending, {{pluralCamel}}.error
 */
export const {{singularCamel}}Keys = {
  all: ['{{folder}}'] as const,
  one: (id: number) => ['{{folder}}', id] as const
